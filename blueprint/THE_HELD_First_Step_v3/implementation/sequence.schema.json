{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "THE HELD sequence-card interchange v3",
  "type": "object",
  "required": [
    "id",
    "chapter",
    "title",
    "minutes",
    "puzzles",
    "actors",
    "initial_state",
    "solution",
    "checkpoint",
    "save_contract",
    "start_min",
    "end_min"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SQ-[0-9]{2}-[0-9]{2}$"
    },
    "chapter": {
      "type": "string",
      "pattern": "^C[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "minutes": {
      "type": "integer",
      "minimum": 1
    },
    "puzzles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^PZ-[0-9]{2}$"
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "start_min": {
      "type": "integer",
      "minimum": 0
    },
    "end_min": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true
}